# Only public, non-secret config belongs in VITE_* variables.
PUBLIC_SITE_URL=https://brice.mymadvisor.ca
VITE_PUBLIC_SITE_URL=https://brice.mymadvisor.ca
PORT=3000
# Set these server-only variables in the host environment. Never commit credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=
# Optional; required only if different from PUBLIC_SITE_URL
ALLOWED_ORIGIN=https://brice.mymadvisor.ca
# Server-only CMS read access; never expose VITE_CMS_* values.
CMS_URL=http://127.0.0.1:1337
CMS_API_TOKEN=
CMS_TIMEOUT_MS=2500
