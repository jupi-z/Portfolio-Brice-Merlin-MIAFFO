# Only public, non-secret config belongs in VITE_* variables.
PUBLIC_SITE_URL=https://brice.mymadvisor.ca
VITE_PUBLIC_SITE_URL=https://brice.mymadvisor.ca
PORT=3000
# Local profile uses Mailpit from docker-compose.yml. For production choose hostinger-email or titan and replace all placeholders.
SMTP_PROVIDER=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=portfolio-local@example.test
CONTACT_TO=qa-inbox@example.test
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
# Optional; required only if different from PUBLIC_SITE_URL
ALLOWED_ORIGIN=https://brice.mymadvisor.ca
# Server-only CMS read access; never expose VITE_CMS_* values.
CMS_URL=http://127.0.0.1:1337
CMS_API_TOKEN=
CMS_TIMEOUT_MS=2500
