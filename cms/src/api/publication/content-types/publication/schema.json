{
  "kind": "collectionType",
  "collectionName": "publications",
  "info": {
    "singularName": "publication",
    "pluralName": "publications",
    "displayName": "Publication",
    "description": "FR/EN articles, analyses, studies, guides, case studies and interventions."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "editorialType": { "type": "enumeration", "enum": ["article", "study", "note", "case-study", "guide", "intervention"], "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "slug": { "type": "uid", "targetField": "title", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "eyebrow": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "excerpt": { "type": "text", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "content": { "type": "dynamiczone", "components": ["publication.heading", "publication.rich-text", "publication.image", "publication.quote", "publication.callout", "publication.table", "publication.download"], "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "cover": { "type": "media", "allowedTypes": ["images"], "multiple": false, "pluginOptions": { "i18n": { "localized": true } } },
    "coverAlt": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "authorName": { "type": "string", "required": true, "default": "Brice Merlin MIAFFO", "pluginOptions": { "i18n": { "localized": true } } },
    "category": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "tags": { "type": "json", "pluginOptions": { "i18n": { "localized": true } } },
    "readingTime": { "type": "integer", "min": 1, "max": 180, "pluginOptions": { "i18n": { "localized": true } } },
    "featured": { "type": "boolean", "default": false },
    "references": { "type": "json", "pluginOptions": { "i18n": { "localized": true } } },
    "related": { "type": "relation", "relation": "manyToMany", "target": "api::publication.publication", "mappedBy": "relatedFrom" },
    "relatedFrom": { "type": "relation", "relation": "manyToMany", "target": "api::publication.publication", "inversedBy": "related" },
    "methodology": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "scope": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "dataDate": { "type": "date", "pluginOptions": { "i18n": { "localized": true } } },
    "limitations": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "publicationAuthorization": { "type": "enumeration", "enum": ["not-required", "pending", "confirmed"], "default": "not-required" },
    "seo": { "type": "component", "component": "publication.seo", "repeatable": false, "pluginOptions": { "i18n": { "localized": true } } }
  }
}
